# APP_URL: Canonical URL where the applet or website is hosted (e.g., https://othmarcreativestudio.com)
APP_URL=""

# RESEND_API_KEY: Server-side API key from Resend (https://resend.com) for sending inquiry notifications.
# (Never expose this in client-side code)
RESEND_API_KEY=""

# NOTIFICATION_EMAIL: Destination email address where inquiry submissions will be delivered.
NOTIFICATION_EMAIL="othmarphilip@gmail.com"

# FROM_EMAIL: Verified sender email address configured in your Resend account.
# Default: Resend testing domain (onboarding@resend.dev) or your verified domain sender (e.g. Inquiries <hello@yourdomain.com>)
FROM_EMAIL="Othmar Studio Inquiries <onboarding@resend.dev>"
